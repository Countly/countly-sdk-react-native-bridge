{
    "arrowParens": "always",
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "jsxSingleQuote": false,
    "quoteProps": "preserve",
    "singleQuote": false,
    "semi": true,
    "printWidth": 300,
    "useTabs": false,
    "tabWidth": 4,
    "trailingComma": "es5",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": "__tests__/**",
            "options": {
                "singleQuote": true
            }
        }
    ]
}
